rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false;
    }

    function isOperationsStaff() {
      return hasRole('property_operations') || hasRole('complaint_operations');
    }

    function isPropertyOperations() {
      return hasRole('property_operations');
    }

    function isTechnician() {
      return hasRole('technician');
    }

    match /users/{userId} {
      // A client may create only its own UID-keyed, unassigned profile.
      // Role assignment is intentionally left to a trusted backend/admin
      // process using the Admin SDK, which is not constrained by these rules.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'phoneNumber',
          'createdAt',
          'updatedAt'
        ]);

      allow read: if request.auth != null
        && (request.auth.uid == userId || isOperationsStaff());

      // Users may update only non-sensitive profile fields. In particular,
      // role, uid, and createdAt cannot be added or changed by the client.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'phoneNumber',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // Reference data is readable only by authenticated operational roles.
    // Property Operations may seed the minimum reference records used by the
    // current GRIH-012 helper; updates and deletes remain closed until their
    // dedicated CRUD workflow is implemented.
    match /properties/{propertyId} {
      allow read: if isOperationsStaff();
      allow create: if isPropertyOperations()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'address', 'status', 'isActive', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'name', 'address', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == propertyId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /units/{unitId} {
      allow read: if isOperationsStaff();
      allow create: if isPropertyOperations()
        && request.resource.data.keys().hasOnly([
          'id', 'propertyId', 'unitNumber', 'floor', 'status',
          'occupancyStatus', 'tenantId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'propertyId', 'unitNumber', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == unitId
        && exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isOperationsStaff();
      allow create: if isPropertyOperations()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'fullName', 'phone', 'email', 'propertyId', 'unitId',
          'linkedUserId', 'status', 'isActive', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'fullName', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == tenantId
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(['unitId'])
          || request.resource.data.keys().hasAny(['propertyId']))
        && (!request.resource.data.keys().hasAny(['propertyId'])
          || exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)))
        && (!request.resource.data.keys().hasAny(['unitId'])
          || (exists(/databases/$(database)/documents/units/$(request.resource.data.unitId))
            && get(/databases/$(database)/documents/units/$(request.resource.data.unitId)).data.propertyId == request.resource.data.propertyId));
      allow update, delete: if false;
    }

    match /complaints/{complaintId} {
      allow read: if isOperationsStaff()
        || (
          hasRole('technician')
          && resource.data.currentTechnicianId == request.auth.uid
          && resource.data.status in ['open', 'assigned', 'in_progress', 'waiting_for_parts', 'reopened']
        );
      allow create: if isOperationsStaff()
        && request.resource.data.keys().hasOnly([
          'tenantId', 'propertyId', 'unitId', 'title', 'description',
          'category', 'priority', 'status', 'currentTechnicianId',
          'visitCount', 'isRepeatVisit', 'reopenCount', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'tenantId', 'propertyId', 'unitId', 'title', 'description',
          'category', 'priority', 'status', 'visitCount', 'isRepeatVisit',
          'reopenCount', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'open'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
        && get(/databases/$(database)/documents/units/$(request.resource.data.unitId)).data.propertyId == request.resource.data.propertyId
        && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.propertyId == request.resource.data.propertyId
        && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.unitId == request.resource.data.unitId;
      // Assignment writes remain narrow. Visit writes are separately guarded
      // below so technicians cannot mutate arbitrary complaint fields.
      allow update: if (
          isOperationsStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'currentTechnicianId', 'firstAssignedAt', 'status', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.currentTechnicianId is string
          && exists(/databases/$(database)/documents/users/$(request.resource.data.currentTechnicianId))
          && get(/databases/$(database)/documents/users/$(request.resource.data.currentTechnicianId)).data.role == 'technician'
          && get(/databases/$(database)/documents/users/$(request.resource.data.currentTechnicianId)).data.isActive != false
          && (
            (
              resource.data.status == 'open'
              && request.resource.data.status == 'assigned'
              && (!resource.data.keys().hasAny(['currentTechnicianId'])
                || resource.data.currentTechnicianId == null)
              && (
                (!resource.data.keys().hasAny(['firstAssignedAt'])
                  && request.resource.data.keys().hasAny(['firstAssignedAt'])
                  && request.resource.data.firstAssignedAt == request.time)
                || (resource.data.keys().hasAny(['firstAssignedAt'])
                  && request.resource.data.keys().hasAny(['firstAssignedAt'])
                  && request.resource.data.firstAssignedAt == resource.data.firstAssignedAt)
              )
            )
            ||
            (
              resource.data.status in ['assigned', 'in_progress', 'waiting_for_parts', 'reopened']
              && request.resource.data.status == resource.data.status
              && resource.data.currentTechnicianId is string
              && request.resource.data.currentTechnicianId != resource.data.currentTechnicianId
              && (
                (!resource.data.keys().hasAny(['firstAssignedAt'])
                  && !request.resource.data.keys().hasAny(['firstAssignedAt']))
                || (resource.data.keys().hasAny(['firstAssignedAt'])
                  && request.resource.data.keys().hasAny(['firstAssignedAt'])
                  && request.resource.data.firstAssignedAt == resource.data.firstAssignedAt)
              )
            )
          )
        )
        || (
          isTechnician()
          && resource.data.currentTechnicianId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'visitCount', 'isRepeatVisit', 'activeVisitId', 'status',
            'resolvedAt', 'updatedAt'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.visitCount is int
          && request.resource.data.isRepeatVisit == (request.resource.data.visitCount > 1)
          && (
            (
              resource.data.status in ['assigned', 'in_progress', 'waiting_for_parts', 'reopened']
              && request.resource.data.status == 'in_progress'
              && request.resource.data.activeVisitId is string
              && (!resource.data.keys().hasAny(['activeVisitId'])
                || resource.data.activeVisitId == null)
              && request.resource.data.visitCount > resource.data.visitCount
              && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.activeVisitId)).data.complaintId == complaintId
              && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.activeVisitId)).data.technicianId == request.auth.uid
              && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.activeVisitId)).data.visitNumber == request.resource.data.visitCount
              && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.activeVisitId)).data.startedAt == request.time
              && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.activeVisitId)).data.completedAt == null
            )
            ||
            (
              resource.data.activeVisitId is string
              && (!request.resource.data.keys().hasAny(['activeVisitId'])
                || request.resource.data.activeVisitId == null)
              && request.resource.data.status in ['in_progress', 'waiting_for_parts', 'resolved']
              && request.resource.data.visitCount == resource.data.visitCount
              && request.resource.data.isRepeatVisit == resource.data.isRepeatVisit
              && getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.complaintId == complaintId
              && getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.technicianId == request.auth.uid
              && getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.completedAt == request.time
              && (
                (getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.outcome == 'resolved'
                  && getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.isResolved == true
                  && request.resource.data.status == 'resolved')
                || (getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.outcome == 'unresolved'
                  && getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.isResolved == false
                  && request.resource.data.status == 'in_progress')
                || (getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.outcome == 'waiting_for_parts'
                  && getAfter(/databases/$(database)/documents/maintenance_visits/$(resource.data.activeVisitId)).data.isResolved == false
                  && request.resource.data.status == 'waiting_for_parts')
              )
              && (
                (request.resource.data.status != 'resolved')
                || (!resource.data.keys().hasAny(['resolvedAt'])
                  || resource.data.resolvedAt == null
                  || request.resource.data.resolvedAt == resource.data.resolvedAt
                  || request.resource.data.resolvedAt == request.time)
              )
            )
          )
          || (
            (isOperationsStaff() || (hasRole('tenant') && request.resource.data.status in ['closed', 'reopened']))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'closedAt', 'closedBy',
              'reopenCount', 'reopenedAt', 'reopenedBy', 'reopenReason',
              'cancelledAt', 'cancelledBy', 'cancellationReason'
            ])
            && request.resource.data.updatedAt == request.time
            && (
              (
                resource.data.status == 'resolved'
                && request.resource.data.status == 'closed'
                && request.resource.data.closedAt == request.time
                && request.resource.data.closedBy == request.auth.uid
              )
              || (
                resource.data.status in ['resolved', 'closed']
                && request.resource.data.status == 'reopened'
                && request.resource.data.reopenedAt == request.time
                && request.resource.data.reopenedBy == request.auth.uid
                && request.resource.data.reopenReason is string
                && request.resource.data.reopenReason.size() > 0
                && request.resource.data.reopenCount == resource.data.reopenCount + 1
              )
              || (
                resource.data.status in ['open', 'assigned', 'waiting_for_parts', 'reopened']
                && request.resource.data.status == 'cancelled'
                && request.resource.data.cancelledAt == request.time
                && request.resource.data.cancelledBy == request.auth.uid
                && request.resource.data.cancellationReason is string
                && request.resource.data.cancellationReason.size() > 0
                && (!resource.data.keys().hasAny(['activeVisitId'])
                  || resource.data.activeVisitId == null)
              )
            )
          )
        );
      allow delete: if false;
    }

    match /maintenance_visits/{visitId} {
      allow read: if isOperationsStaff()
        || (
          isTechnician()
          && get(/databases/$(database)/documents/complaints/$(resource.data.complaintId)).data.currentTechnicianId == request.auth.uid
        );
      allow create: if isTechnician()
        && request.resource.data.keys().hasOnly([
          'complaintId', 'technicianId', 'visitNumber', 'startedAt',
          'completedAt', 'observation', 'actionTaken', 'outcome',
          'isResolved', 'followUpRequired', 'followUpNotes',
          'resolutionSummary', 'operationId'
        ])
        && request.resource.data.keys().hasAll([
          'complaintId', 'technicianId', 'visitNumber', 'startedAt',
          'completedAt', 'observation', 'actionTaken', 'outcome',
          'isResolved', 'followUpRequired', 'followUpNotes',
          'resolutionSummary', 'operationId'
        ])
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.completedAt == null
        && request.resource.data.observation == null
        && request.resource.data.actionTaken == null
        && request.resource.data.outcome == null
        && request.resource.data.isResolved == false
        && request.resource.data.followUpRequired == false
        && request.resource.data.operationId is string
        && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.currentTechnicianId == request.auth.uid
        && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.activeVisitId == visitId
        && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == 'in_progress'
        && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.visitCount == request.resource.data.visitNumber;
      allow update: if isTechnician()
        && resource.data.technicianId == request.auth.uid
        && get(/databases/$(database)/documents/complaints/$(resource.data.complaintId)).data.currentTechnicianId == request.auth.uid
        && resource.data.completedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'completedAt', 'observation', 'actionTaken', 'outcome',
          'isResolved', 'followUpRequired', 'followUpNotes',
          'resolutionSummary'
        ])
        && request.resource.data.completedAt == request.time
        && request.resource.data.observation is string
        && request.resource.data.observation.size() > 0
        && request.resource.data.actionTaken is string
        && request.resource.data.actionTaken.size() > 0
        && request.resource.data.outcome in ['resolved', 'unresolved', 'waiting_for_parts']
        && request.resource.data.isResolved is bool
        && request.resource.data.followUpRequired is bool
        && (
          (request.resource.data.outcome == 'resolved' && request.resource.data.isResolved == true)
          || (request.resource.data.outcome in ['unresolved', 'waiting_for_parts'] && request.resource.data.isResolved == false)
        )
        && (!getAfter(/databases/$(database)/documents/complaints/$(resource.data.complaintId)).data.keys().hasAny(['activeVisitId'])
          || getAfter(/databases/$(database)/documents/complaints/$(resource.data.complaintId)).data.activeVisitId == null);
      allow delete: if false;
    }

    match /technician_assignments/{assignmentId} {
      allow read: if isOperationsStaff();
      allow create: if isOperationsStaff()
        && request.resource.data.keys().hasOnly([
          'complaintId', 'previousTechnicianId', 'newTechnicianId',
          'assignedBy', 'assignedAt', 'assignmentType', 'operationId', 'reason'
        ])
        && request.resource.data.keys().hasAll([
          'complaintId', 'previousTechnicianId', 'newTechnicianId',
          'assignedBy', 'assignedAt', 'assignmentType', 'operationId'
        ])
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.assignedAt == request.time
        && exists(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId))
        && request.resource.data.newTechnicianId is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.newTechnicianId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.newTechnicianId)).data.role == 'technician'
        && get(/databases/$(database)/documents/users/$(request.resource.data.newTechnicianId)).data.isActive != false
        && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.currentTechnicianId == request.resource.data.newTechnicianId
        && (
          (request.resource.data.assignmentType == 'INITIAL_ASSIGNMENT'
            && request.resource.data.previousTechnicianId == null
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == 'assigned')
          ||
          (request.resource.data.assignmentType == 'REASSIGNMENT'
            && request.resource.data.previousTechnicianId is string
            && request.resource.data.previousTechnicianId != request.resource.data.newTechnicianId
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == get(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status)
        );
      allow update, delete: if false;
    }

    match /audit_events/{eventId} {
      allow read: if isOperationsStaff()
        || (
          isTechnician()
          && get(/databases/$(database)/documents/complaints/$(resource.data.complaintId)).data.currentTechnicianId == request.auth.uid
        );
      allow create: if (isOperationsStaff() || isTechnician())
        && request.resource.data.keys().hasOnly([
          'complaintId', 'eventType', 'actorId', 'actorRole', 'createdAt',
          'metadata', 'previousValue', 'newValue', 'reason', 'schemaVersion'
        ])
        && request.resource.data.keys().hasAll([
          'complaintId', 'eventType', 'actorId', 'actorRole', 'createdAt',
          'metadata', 'schemaVersion'
        ])
        && request.resource.data.complaintId is string
        && request.resource.data.eventType in [
          'COMPLAINT_CREATED', 'COMPLAINT_UPDATED',
          'TECHNICIAN_ASSIGNED', 'TECHNICIAN_REASSIGNED',
          'COMPLAINT_STATUS_CHANGED', 'COMPLAINT_RESOLVED',
          'COMPLAINT_REOPENED', 'COMPLAINT_CLOSED',
          'COMPLAINT_CANCELLED', 'COMPLAINT_WAITING_FOR_PARTS',
          'PRIORITY_CHANGED', 'TECHNICIAN_ACCEPTED', 'TRAVEL_STARTED',
          'TECHNICIAN_ARRIVED', 'INSPECTION_STARTED', 'REPAIR_STARTED',
          'PHOTO_UPLOADED', 'PART_ADDED', 'NEEDS_ANOTHER_VISIT',
          'TENANT_NOTIFIED', 'VISIT_STARTED', 'VISIT_COMPLETED',
          'FOLLOW_UP_REQUESTED'
        ]
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role
        && request.resource.data.actorRole in [
          'property_operations', 'complaint_operations', 'technician',
          'property_owner', 'tenant'
        ]
        && request.resource.data.createdAt == request.time
        && request.resource.data.metadata is map
        && request.resource.data.schemaVersion == 1
        && (
          (
            request.resource.data.eventType == 'COMPLAINT_CREATED'
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.createdBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == 'open'
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.createdAt == request.time
          )
          ||
          (
            request.resource.data.eventType in ['TECHNICIAN_ASSIGNED', 'TECHNICIAN_REASSIGNED']
            && request.resource.data.metadata.keys().hasOnly([
              'previousTechnicianId', 'newTechnicianId', 'assignmentType',
              'operationId', 'reason'
            ])
            && request.resource.data.metadata.keys().hasAll([
              'previousTechnicianId', 'newTechnicianId', 'assignmentType', 'operationId'
            ])
            && request.resource.data.metadata.newTechnicianId == getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.currentTechnicianId
            && (
              (
                request.resource.data.eventType == 'TECHNICIAN_ASSIGNED'
                && request.resource.data.metadata.assignmentType == 'INITIAL_ASSIGNMENT'
                && request.resource.data.metadata.previousTechnicianId == null
                && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == 'assigned'
                && (
                  !get(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.keys().hasAny(['currentTechnicianId'])
                  || get(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.currentTechnicianId == null
                )
              )
              ||
              (
                request.resource.data.eventType == 'TECHNICIAN_REASSIGNED'
                && request.resource.data.metadata.assignmentType == 'REASSIGNMENT'
                && request.resource.data.metadata.previousTechnicianId is string
                && get(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.currentTechnicianId == request.resource.data.metadata.previousTechnicianId
                && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == get(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status
              )
            )
          )
          ||
          (
            request.resource.data.eventType == 'VISIT_STARTED'
            && request.resource.data.metadata.keys().hasOnly([
              'visitId', 'visitNumber', 'technicianId', 'previousStatus',
              'newStatus', 'operationId'
            ])
            && request.resource.data.metadata.keys().hasAll([
              'visitId', 'visitNumber', 'technicianId', 'previousStatus',
              'newStatus', 'operationId'
            ])
            && request.resource.data.metadata.technicianId == request.auth.uid
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.complaintId == request.resource.data.complaintId
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.startedAt == request.time
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.activeVisitId == request.resource.data.metadata.visitId
          )
          ||
          (
            request.resource.data.eventType == 'VISIT_COMPLETED'
            && request.resource.data.metadata.keys().hasOnly([
              'visitId', 'visitNumber', 'technicianId', 'previousStatus',
              'newStatus', 'outcome', 'isResolved', 'followUpRequired'
            ])
            && request.resource.data.metadata.keys().hasAll([
              'visitId', 'visitNumber', 'technicianId', 'previousStatus',
              'newStatus', 'outcome', 'isResolved', 'followUpRequired'
            ])
            && request.resource.data.metadata.technicianId == request.auth.uid
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.complaintId == request.resource.data.complaintId
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.completedAt == request.time
            && (!getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.keys().hasAny(['activeVisitId'])
              || getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.activeVisitId == null)
          )
          ||
          (
            request.resource.data.eventType == 'COMPLAINT_STATUS_CHANGED'
            && request.resource.data.metadata.keys().hasOnly([
              'visitId', 'visitNumber', 'previousStatus', 'newStatus', 'outcome'
            ])
            && request.resource.data.metadata.keys().hasAll([
              'visitId', 'visitNumber', 'previousStatus', 'newStatus'
            ])
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.complaintId == request.resource.data.complaintId
            && (
              getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.startedAt == request.time
              || getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.completedAt == request.time
            )
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == request.resource.data.metadata.newStatus
          )
          ||
          (
            (
              (isOperationsStaff() && request.resource.data.eventType in [
                'COMPLAINT_CLOSED', 'COMPLAINT_REOPENED', 'COMPLAINT_CANCELLED'
              ])
              || (hasRole('tenant') && request.resource.data.eventType in [
                'COMPLAINT_CLOSED', 'COMPLAINT_REOPENED'
              ])
            )
            && request.resource.data.metadata.keys().hasOnly([
              'previousStatus', 'newStatus', 'operationId', 'reason'
            ])
            && request.resource.data.metadata.keys().hasAll([
              'previousStatus', 'newStatus', 'operationId'
            ])
            && request.resource.data.metadata.previousStatus == get(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == request.resource.data.metadata.newStatus
            && (
              (
                request.resource.data.eventType == 'COMPLAINT_CLOSED'
                && request.resource.data.metadata.previousStatus == 'resolved'
                && request.resource.data.metadata.newStatus == 'closed'
                && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.closedAt == request.time
              )
              || (
                request.resource.data.eventType == 'COMPLAINT_REOPENED'
                && request.resource.data.metadata.previousStatus in ['resolved', 'closed']
                && request.resource.data.metadata.newStatus == 'reopened'
                && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.reopenedAt == request.time
              )
              || (
                request.resource.data.eventType == 'COMPLAINT_CANCELLED'
                && request.resource.data.metadata.previousStatus in ['open', 'assigned', 'waiting_for_parts', 'reopened']
                && request.resource.data.metadata.newStatus == 'cancelled'
                && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.cancelledAt == request.time
              )
            )
          )
          ||
          (
            request.resource.data.eventType == 'FOLLOW_UP_REQUESTED'
            && request.resource.data.metadata.keys().hasOnly([
              'visitId', 'visitNumber', 'followUpNotes', 'outcome'
            ])
            && request.resource.data.metadata.keys().hasAll([
              'visitId', 'visitNumber', 'followUpNotes'
            ])
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.complaintId == request.resource.data.complaintId
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.technicianId == request.auth.uid
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.completedAt == request.time
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.followUpRequired == true
          )
          ||
          (
            request.resource.data.eventType in [
              'TECHNICIAN_ACCEPTED', 'TRAVEL_STARTED',
              'TECHNICIAN_ARRIVED', 'INSPECTION_STARTED', 'REPAIR_STARTED',
              'PHOTO_UPLOADED', 'PART_ADDED', 'NEEDS_ANOTHER_VISIT',
              'TENANT_NOTIFIED'
            ]
            && request.resource.data.metadata.keys().hasOnly([
              'visitId', 'technicianId', 'step', 'note', 'photos',
              'photoUrl', 'group', 'name', 'quantity', 'cost'
            ])
            && request.resource.data.metadata.keys().hasAll([
              'visitId', 'technicianId'
            ])
            && request.resource.data.metadata.technicianId == request.auth.uid
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.complaintId == request.resource.data.complaintId
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.technicianId == request.auth.uid
            && getAfter(/databases/$(database)/documents/maintenance_visits/$(request.resource.data.metadata.visitId)).data.completedAt == null
            && getAfter(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.activeVisitId == request.resource.data.metadata.visitId
          )
        );
      allow update, delete: if false;
    }

    // All future collections remain closed until their authorized workflows
    // and invariants are implemented explicitly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
